- name: crc_packet_statistics
  id: epy_block
  parameters:
    _source_code: "import collections\nimport numpy as np\nfrom gnuradio import gr\n\
      \n\nclass blk(gr.sync_block):\n    \"\"\"Convert one CRC byte per decoded packet\
      \ into live packet statistics.\"\"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"CRC Packet Statistics\",\n          \
      \  in_sig=[np.uint8],\n            out_sig=[\n                np.float32,\n\
      \                np.float32,\n                np.float32,\n                np.float32,\n\
      \                np.float32,\n            ],\n        )\n        self.total\
      \ = 0\n        self.valid = 0\n        self.recent = collections.deque(maxlen=10)\n\
      \n    def work(self, input_items, output_items):\n        source = input_items[0]\n\
      \        count = min(\n            len(source),\n            *(len(output) for\
      \ output in output_items),\n        )\n        for index in range(count):\n\
      \            current = 1.0 if int(source[index]) != 0 else 0.0\n           \
      \ self.total += 1\n            self.valid += int(current)\n            self.recent.append(current)\n\
      \n            output_items[0][index] = current\n            output_items[1][index]\
      \ = float(self.total)\n            output_items[2][index] = float(self.valid)\n\
      \            output_items[3][index] = 100.0 * self.valid / self.total\n    \
      \        output_items[4][index] = (\n                100.0 * sum(self.recent)\
      \ / len(self.recent)\n            )\n        return count"
    affinity: ''
    alias: ''
    comment: "\u6BCF\u4E2A\u5B8C\u6574\u89E3\u7801\u5305\u8F93\u5165\u4E00\u4E2A CRC\
      \ 0/1\uFF0C\u7EDF\u8BA1\u7D2F\u8BA1\u6210\u529F\u7387\u548C\u6700\u8FD1 10 \u5305\
      \u6210\u529F\u7387"
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('CRC Packet Statistics', 'blk', [], [('0', 'byte', 1)], [('0', 'float',
      1), ('1', 'float', 1), ('2', 'float', 1), ('3', 'float', 1), ('4', 'float',
      1)], 'Convert one CRC byte per decoded packet into live packet statistics.',
      [])
    bus_sink: false
