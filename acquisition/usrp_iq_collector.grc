options:
  parameters:
    author: OpenAI Codex
    catch_exceptions: 'True'
    category: '[LoRa Experiments]'
    cmake_opt: ''
    comment: "B210 \u73B0\u573A IQ \u91C7\u96C6\uFF1A\u5B9E\u65F6\u9891\u8C31\u3001\
      LoRa CRC \u7EDF\u8BA1\u548C\u53EF\u63A7 complex64 \u5199\u76D8\u3002"
    copyright: ''
    description: "\u91C7\u96C6\u524D\u5148\u5B9E\u65F6\u89E3\u8C03\u5E76\u68C0\u67E5\
      \ CRC\uFF0C\u786E\u8BA4\u4F4D\u7F6E\u53EF\u7528\u540E\u518D\u6253\u5F00\u6B63\
      \u5F0F\u5F55\u5236\u5F00\u5173\u3002"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: usrp_iq_collector
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "USRP LoRa \u5B9E\u65F6 CRC \u53EF\u89C6\u5316\u91C7\u96C6\u5668"
    window_size: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 12]
    rotation: 0
    state: enabled

